{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(python3 -m unittest*)",
      "Bash(python3 tests/*)",
      "Bash(python3 scripts/*)",
      "Bash(node --test*)",
      "Bash(node tests/*)",
      "Bash(node scripts/*)",
      "Bash(scripts/audit/*)",
      "Bash(sh scripts/rebuild-js.sh*)",
      "Bash(python3 -m http.server*)",
      "WebFetch(domain:superchargeddaily.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:www.w3.org)"
    ],
    "ask": [
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(npx wrangler*)",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__create_edge_function_secret",
      "mcp__Supabase__create_project",
      "mcp__Supabase__create_branch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit.py\"",
            "timeout": 240,
            "statusMessage": "Checking the commit (secrets, syntax, tests)..."
          }
        ]
      }
    ]
  }
}

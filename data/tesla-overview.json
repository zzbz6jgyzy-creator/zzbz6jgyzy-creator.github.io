    {
      "url": "/dispatch/tesla-spacex-government-contracts.html",
      "image": "/assets/dispatch/falcon9-crew10-launch.jpg",
      "title": "Elon says Tesla has no government contracts, and SpaceX government work will be under 10% of revenue this quarter",
      "summary": "Elon Musk said Tesla has no government contracts and that government revenue will be under 10% of SpaceX revenue this quarter and under 5% a year from now, quoting a Warren Redlich draft letter. Those figures are his claims on X, not filings.",
      "tag": "Governance",
      "date": "2026-11-06T18:31:00Z",
      "thumb": "/assets/dispatch/falcon9-crew10-launch-480w.webp"
    },
    {

      "definition": "A major collision is one severe enough to deploy an airbag or seatbelt pretensioner, or to fire the high-voltage battery pyro fuse. Tesla counts a crash as an FSD crash if FSD was active at any point in the five seconds before impact."
    },
    "eu": {
      "source": "evwire-eu-safety",
      "critic": "automotiveworld-safety",
      "multiple": 4.1,
      "km": 102,
      "july": {
        "multiple": 5.2,
        "km": 65
      },
      "also": "drive-tesla-eu-safety",
      "window": "10 April to 24 August 2026",
      "fsdCollisions": 12,
